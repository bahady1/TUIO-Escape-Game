  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeRoom.GameHUD
  leftRoom: {fileID: 362012369}
  rightRoom: {fileID: 1954810021}
  timeLimitMinutes: 15
  startTimerOnPlay: 0
  warningSeconds: 60
  startMessage: The power is out! Turn object 1 to look around the lab, object 2
    for the server room.
  hints:
  - The switchbox in the server room controls the power. The lab has the clue.
  - Look closely at the old circuit poster in the lab.
  - Put the ring on the switchbox for 2 seconds, then turn it 90 degrees.
  - Each knob can be up, middle or down. Tap a knob to move it.
  - Turn the ring back 90 degrees to step away from the switchbox.
  hintHotkey: 1
  barHeight: 84
  barColor: {r: 0.05, g: 0.06, b: 0.08, a: 1}
