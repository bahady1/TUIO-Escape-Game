MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1447006001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 668ba614414decc4aba7edc2b3b0e99c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeRoom.RoomInteractable
  kind: 1
  role: 2
  puzzle: 2
  title: MAINTENANCE REVISION 04
  body: 'A stable relay contains EXACTLY TWO 1s. Turn all other relays OFF. Ignore
    colours.


    Read each row left to right: ON=1, OFF=0. Bit weights are 8, 4,
    2, 1.


    Digit 1 = top row in decimal.

    Digit 2 = bottom row in decimal.

    Digit
    3 = top XOR bottom in decimal.

    XOR: equal bits = 0; different bits = 1.


    Enter
    all three digits at the server-room console; both operators then authorise together
    for two seconds.'
  worldLabel: {fileID: 1131056712}
