  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 25
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 12
    m_MaxSize: 25
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 'A stable relay contains EXACTLY TWO 1s. Turn all other relays OFF. Ignore
    colours.


    Read each row left to right: ON=1, OFF=0. Bit weights are 8, 4,
    2, 1.


    Digit 1 = top row in decimal.

    Digit 2 = bottom row in decimal.

    Digit
    3 = top XOR bottom in decimal.

    XOR: equal bits = 0; different bits = 1.


    Enter
    all three digits; both operators then authorise together for two seconds.'
