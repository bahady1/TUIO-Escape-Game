  m_Script: {fileID: 11500000, guid: c43c3ad135f1555498815f163f5343ec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeRoom.IntroDialogue
  lines:
  - Two IT students arrive early at Lab 24 to prepare for an important exam. Student
    A enters the main computer lab, while Student B checks the smaller server room
    inside.
  - Without warning, a power failure triggers an automatic security lockdown, turning
    off the lights, locking the internal connecting door, and trapping the students
    on opposite sides with only 15 minutes before their exam.
  speaker: LAB 24  -  07:42
  charactersPerSecond: 45
  powerFailsOnLine: 1
  startDelay: 0.6
  accentColor: {r: 0.25, g: 0.85, b: 1, a: 1}
