  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.08, g: 0.09, b: 0.14, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 30
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 8
    m_MaxSize: 30
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 'A stable relay contains EXACTLY TWO 1s. Turn all other relays OFF. Ignore
    colours.


    Read each row left to right: ON=1, OFF=0. Bit weights are 8, 4,
    2, 1.


    Digit 1 = top row in decimal.

    Digit 2 = bottom row in decimal.

    Digit
    3 = top XOR bottom in decimal.

    XOR: equal bits = 0; different bits = 1.


    Enter
    all three digits at the server-room console; both operators then authorise together
    for two seconds.'
